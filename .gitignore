# graphify dependency-graph output — regenerate locally with `graphify update .`;
# not published, it's internal dev tooling, not something a repo reader needs.
graphify-out/

# Language/runtime artifacts
__pycache__/
*.pyc
.venv/
venv/
node_modules/
dist/
build/
*.egg-info/

# Go
*.exe
*.test
*.out
vendor/

# Embedded SQLite data (per-checkout state, not source)
/data/
*.db

# Plugin: built binary + build marker (regenerated by ensure-engine.sh);
# plugin/engine/ IS tracked — it's the synced, distributable engine source.
/plugin/bin/

# Local env / secrets
.env
.env.*
!.env.example

# Presentation: keep the Markdown source, ignore generated PDF/PPTX/HTML
# (regenerate with `npx @marp-team/marp-cli presentacion.md --pdf/--pptx/--html`)
presentacion/*.pdf
presentacion/*.pptx
presentacion/*.html
