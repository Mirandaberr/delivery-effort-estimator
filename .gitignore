# graphify build cache and dated snapshot backups (regenerated by `graphify update .`)
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Language/runtime artifacts
__pycache__/
*.pyc
.venv/
venv/
node_modules/
dist/
build/
*.egg-info/

# Go
*.exe
*.test
*.out
vendor/

# Embedded SQLite data (per-checkout state, not source)
/data/
*.db

# Local env / secrets
.env
.env.*
!.env.example
